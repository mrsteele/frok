# Optional development / troubleshooting overrides. No environment file is
# needed to use Frok Desktop. Configure connections, pipelines, live previews,
# job timeout and Ollama startup in Settings → Generate / Pipelines.
#
# Existing preference variables are imported once into the library. Editing
# those variables later does not override Settings. Original files are kept.
# See docs/desktop.md for migration and workspace details.

# Workspace / local server overrides (set FROK_HOME before launching Electron).
# FROK_HOME=/absolute/path/to/frok-workspace
# FROK_DATA_DIR=.data
# FROK_DESKTOP_PORT=3440
# PORT=3000
# FROK_ORIGIN=http://127.0.0.1:3000

# Optional executable overrides. Normal installations use detected/bundled tools.
# VPIPE_BIN=/absolute/path/to/vpipe
# OLLAMA_BIN=/absolute/path/to/ollama
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# FFPROBE_BIN=/absolute/path/to/ffprobe
# REALESRGAN_BIN=/absolute/path/to/realesrgan-ncnn-vulkan
# REALESRGAN_MODEL_DIR=/absolute/path/to/realesrgan/models

# Browser development only: Electron users save tokens in Settings → Generate
# → API tokens. Desktop imports old workspace credentials into OS secure storage.
# Accept the model's Hugging Face license before preparing a gated model.
# HF_TOKEN=
# COMFYUI_API_KEY=

# Legacy remote ComfyUI installations only: the raw API must already be protected.
# Stock ComfyUI ignores a bearer header; it does not secure the service by itself.
# FROK_COMFYUI_PRIVATE=1
