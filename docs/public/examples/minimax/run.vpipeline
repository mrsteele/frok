      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12,
        "audio_shift": 3,
        "condition_timestep": 1,
        "audio_seconds": 0,
        "lora": "larryvrh/MiniMax-H3-Turbo-Lora-v4-600-ema",
        "lora_scale": 1
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        }
      ],
      "config": {
        "sol_attn": true,
        "height": 512,
        "width": 512,
        "frames": 158,
        "fps": 24,
        "steps": 6,
        "seed": 42,
        "i8_gemm": true,
        "unload_when_idle": "always",
        "sol_tau": 1,
        "sol_key_block": 64,
        "sol_dense_layers": 1,
        "sol_local_radius": 1
      }
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
